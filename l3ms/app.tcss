Screen {
    layout: vertical;
}

TabbedContent {
    height: 1fr;
}

.panel {
    height: 1fr;
    padding: 1;
}

.row {
    height: auto;
    margin-bottom: 1;
}

.main {
    height: 1fr;
}

.left {
    width: 1fr;
    min-width: 70;
    margin-right: 1;
}

.right {
    width: 1fr;
}

#models_table {
    height: 1fr;
    min-height: 12;
    margin-bottom: 1;
}

#run_scripts_table {
    height: 1fr;
    min-height: 14;
    margin-bottom: 1;
}

Input {
    width: 1fr;
    min-width: 20;
}

Select {
    width: 35;
}

Checkbox {
    width: auto;
}

#activity_log {
    height: 12;
    border: round $accent;
}

#run_log {
    height: 14;
    border: round $accent;
}

#run_selected_path {
    margin-bottom: 1;
    padding: 0 1;
    border: round $accent;
}

#run_current_model,
#run_resources {
    width: 1fr;
    padding: 0 1;
    border: round $accent;
}

#run_editor {
    height: 1fr;
    min-height: 16;
    border: round $accent;
}

/* ---- Chat Panel ---- */

#chat_panel {
    height: 1fr;
}

#chat_log {
    height: 1fr;
    min-height: 10;
    border: round $accent;
    margin-bottom: 1;
}

#chat_status {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#chat_model_label {
    width: 1fr;
    padding: 0 1;
}

.chat_port_input {
    width: 10;
    min-width: 6;
}

.chat_input_row {
    height: auto;
    margin-top: 0;
}

#chat_input {
    width: 1fr;
}

.key_hint {
    color: $text-disabled;
    text-style: dim;
    height: auto;
    margin-top: 1;
}

/* Maintenance Panel */
#maint_table {
    height: 1fr;
    min-height: 8;
    margin-bottom: 1;
}
#maint_log {
    height: 10;
    border: round $accent;
}
#maint_editor {
    height: 1fr;
    min-height: 16;
    border: round $accent;
}
#maint_selected_path {
    margin-bottom: 1;
    padding: 0 1;
    border: round $accent;
}
#maint_status {
    width: 1fr;
    padding: 0 1;
}

/* Chat streaming preview */
#chat_stream_preview {
    height: auto;
    min-height: 2;
    max-height: 20;
    border: round $warning;
    padding: 0 1;
    margin-bottom: 1;
    display: none;
}

.chat_small_input {
    width: 10;
    min-width: 6;
}

.chat_params_row {
    height: auto;
    margin-bottom: 1;
}

/* Jobs Panel */
#jobs_table {
    height: 1fr;
    min-height: 10;
}
