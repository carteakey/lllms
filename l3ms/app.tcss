Screen {
    layout: vertical;
    background: $surface;
}

TabbedContent {
    height: 1fr;
}

.panel {
    height: 1fr;
    padding: 1;
    background: $surface;
}

.row {
    height: auto;
    margin-bottom: 1;
}

.main {
    height: 1fr;
}

.left {
    width: 1fr;
    min-width: 70;
    margin-right: 1;
}

.right {
    width: 1fr;
}

#models_table {
    height: 1fr;
    min-height: 12;
    margin-bottom: 1;
    border: tall $panel;
}

#run_scripts_table {
    height: 1fr;
    min-height: 14;
    margin-bottom: 1;
    border: tall $panel;
}

#browser_table {
    height: 1fr;
    min-height: 12;
    margin-bottom: 1;
    border: tall $panel;
}

Input {
    width: 1fr;
    min-width: 20;
}

Select {
    width: 35;
}

Checkbox {
    width: auto;
}

#activity_log {
    height: 12;
    border: tall $accent;
}

#run_log {
    height: 14;
    border: tall $accent;
}

#browser_log {
    height: 10;
    border: tall $accent;
}

#run_selected_path {
    margin-bottom: 1;
    padding: 0 1;
    border: tall $panel;
}

#browser_selected_path {
    margin-bottom: 1;
    padding: 0 1;
    border: tall $panel;
}

#run_current_model,
#run_resources {
    width: 1fr;
    padding: 0 1;
    border: tall $panel;
}

#browser_summary {
    width: auto;
    padding: 0 1;
    border: tall $panel;
}

#run_editor {
    height: 1fr;
    min-height: 16;
    border: tall $panel;
}

#browser_details {
    height: 1fr;
    min-height: 16;
    border: tall $panel;
    padding: 0 1;
}

#workbench_bar {
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
    border-bottom: solid $panel;
}

/* ---- Chat Panel ---- */

#chat_panel {
    height: 1fr;
}

#chat_log {
    height: 1fr;
    min-height: 10;
    border: tall $panel;
    margin-bottom: 1;
}

#chat_status {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#chat_model_label {
    width: 1fr;
    padding: 0 1;
}

.chat_port_input {
    width: 10;
    min-width: 6;
}

.chat_input_row {
    height: auto;
    margin-top: 0;
}

#chat_input {
    width: 1fr;
}

.key_hint {
    color: $text-muted;
    height: auto;
    margin-top: 1;
}

.shortcut_strip {
    height: 1;
    padding: 0 1;
    background: $boost;
    border-left: tall $panel;
    border-right: tall $panel;
}

#start_title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#start_intro {
    border: tall $panel;
    padding: 0 1;
    margin-bottom: 1;
}

.start_action {
    width: 1fr;
    min-width: 14;
}

.start_grid {
    height: auto;
}

.start_column {
    width: 1fr;
    margin-right: 1;
    border: tall $panel;
    padding: 0 1 1 1;
}

.start_group {
    color: $text-muted;
    margin-bottom: 1;
}

Button:focus,
DataTable:focus {
    text-style: bold;
    border: tall $accent;
}

/* Maintenance Panel */
#maint_table {
    height: 1fr;
    min-height: 8;
    margin-bottom: 1;
    border: tall $panel;
}
#maint_log {
    height: 10;
    border: tall $accent;
}
#maint_editor {
    height: 1fr;
    min-height: 16;
    border: tall $panel;
}
#maint_selected_path {
    margin-bottom: 1;
    padding: 0 1;
    border: tall $panel;
}
#maint_status {
    width: 1fr;
    padding: 0 1;
}

/* Chat streaming preview */
#chat_stream_preview {
    height: auto;
    min-height: 2;
    max-height: 20;
    border: tall $warning;
    padding: 0 1;
    margin-bottom: 1;
    display: none;
}

.chat_small_input {
    width: 10;
    min-width: 6;
}

.chat_params_row {
    height: auto;
    margin-bottom: 1;
}

/* Jobs Panel */
#jobs_table {
    height: 1fr;
    min-height: 10;
    border: tall $panel;
}

#jobs_status {
    width: auto;
    padding: 0 1;
    border: tall $panel;
}

/* Chat History Screen */
ChatHistoryScreen {
    align: center middle;
}

#history_dialog {
    width: 70;
    height: auto;
    max-height: 80vh;
    border: tall $accent;
    background: $surface;
    padding: 0 0 1 0;
    overflow-y: auto;
}

#history_title {
    background: $accent;
    color: $text;
    text-style: bold;
    text-align: center;
    padding: 0 2;
    width: 1fr;
}

#history_table {
    height: auto;
    max-height: 40;
    margin: 1 2;
}

#history_empty {
    padding: 0 2;
    width: 1fr;
}

#history_hint {
    text-align: center;
    width: 1fr;
    padding: 0 2;
}

/* Command Palette Screen */
CommandPaletteScreen {
    align: center middle;
}

#palette_dialog {
    width: 78;
    height: auto;
    max-height: 80vh;
    border: tall $accent;
    background: $surface;
    padding: 0 0 1 0;
    overflow-y: auto;
}

#palette_title {
    background: $accent;
    color: $text;
    text-style: bold;
    text-align: center;
    padding: 0 2;
    width: 1fr;
}

#palette_input {
    margin: 1 2 0 2;
    width: 1fr;
}

#palette_table {
    height: auto;
    max-height: 40;
    margin: 0 2;
    border: tall $panel;
}

#palette_hint {
    text-align: center;
    width: 1fr;
    padding: 0 2;
}

/* Help overlay (HelpScreen modal) */
HelpScreen {
    align: center middle;
}

#help_dialog {
    width: 58;
    height: auto;
    max-height: 80vh;
    border: tall $accent;
    background: $surface;
    padding: 0 0 1 0;
    overflow-y: auto;
}

#help_title {
    background: $accent;
    color: $text;
    text-style: bold;
    text-align: center;
    padding: 0 2;
    width: 1fr;
}

#help_body {
    padding: 0 2;
    width: 1fr;
}
