[Unit]
Description=Gemma 4 26B-A4B Vision (llama.cpp)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/kchauhan/repos/l3ms
ExecStart=/home/kchauhan/repos/l3ms/run-models/run-llama-cpp-gemma-4-26b-a4b-vision.sh
Environment=HOST=0.0.0.0
Environment=PORT=8001
Environment=FIT_TARGET=2048
Environment=GGML_CUDA_GRAPH_OPT=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
