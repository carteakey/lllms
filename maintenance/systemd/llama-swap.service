[Unit]
Description=llama-swap (L3MS model router)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/kchauhan/repos/l3ms
Environment=L3MS_ROOT=/home/kchauhan/repos/l3ms
ExecStart=/home/kchauhan/bin/llama-swap -config /home/kchauhan/repos/l3ms/llama-swap.yaml -listen :8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
